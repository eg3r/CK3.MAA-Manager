######################################################
# Men-At-Arms Manager - Early-load compatibility override
#
# Our window_military.gui shows the Order of Battle board directly. If another
# mod replaces window_military.gui, its vanilla vbox_your_armies still shows
# the board through this type override (00_/zz_ cover either load order).
######################################################

types MenAtArmsManagerTypes
{
	# Override using shared type definition
	type vbox_your_armies = vbox_your_armies_with_maa_manager
}
