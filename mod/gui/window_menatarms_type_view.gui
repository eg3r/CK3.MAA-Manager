												texture = "[MenAtArmsType.GetHorizontalImageForCulture( GetPlayer.GetCulture )]"
											}
										}
									}
									using = tooltip_ws
								}

								# Fallback only (the current type is normally priced when the armory
								# opens): it is selected but unpriced, so price it and this type.
								button_normal = {
									visible = "[And( Not( MenAtArmsTypeViewTypeItem.IsSelected ), And( Not( GetScriptedGui('maam_rt_src_known_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), ObjectsEqual( MenAtArmsType.Self, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType ) ) )]"
									size = { 100% 100% }
									tooltipwidget = {
										widget_maa_type_container_tooltip = {
											datacontext = "[MenAtArmsTypeViewTypeItem.GetMenAtArmsType]"
											blockoverride "maa_texture" {
												texture = "[MenAtArmsType.GetHorizontalImageForCulture( GetPlayer.GetCulture )]"
											}
										}
									}
									using = tooltip_ws
									enabled = "[And( And( MenAtArmsTypeViewTypeItem.CanCreate, And( And( IsGamePaused, Not( GetVariableSystem.Exists( 'maam_rt_busy' ) ) ), GetScriptedGui('maam_rt_can_price_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), EqualTo_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_rt_name_matches' ).CountVisibleChildren, '(int32)1' ) )]"
									onclick = "[GetVariableSystem.Set( 'maam_rt_busy', 'yes' )]"
									onclick = "[GetVariableSystem.Set( 'maam_rt_reopen_gui', 'yes' )]"
									onclick = "[GetVariableSystem.Set( 'maam_rt_name', MenAtArmsTypeViewTypeItem.GetMenAtArmsType.GetNameNoTooltip )]"
									onclick = "[GetScriptedGui('maam_rt_pc_begin_src').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'real_relation', MakeScopeFlag( Select_CString( ObjectsEqual( MenAtArmsType.Self, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType ), 'same', 'different' ) ) ).End )]"
									onclick = "[MenAtArmsTypeView.Create]"
									onclick = "[GetScriptedGui('maam_rt_pc_quote_src').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
									onclick = "[MenAtArmsTypeViewTypeItem.OnClick]"
									onclick = "[GetScriptedGui('maam_rt_pc_begin_tgt').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'name_unique', MakeScopeFlag( Select_CString( EqualTo_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_rt_name_matches' ).CountVisibleChildren, '(int32)1' ), 'yes', 'no' ) ) ).End )]"
									onclick = "[MenAtArmsTypeView.Create]"
									onclick = "[GetScriptedGui('maam_rt_pc_quote_tgt').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}

								# Later picks: price only this type.
								button_normal = {
									visible = "[And( Not( MenAtArmsTypeViewTypeItem.IsSelected ), Or( GetScriptedGui('maam_rt_src_known_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Not( ObjectsEqual( MenAtArmsType.Self, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType ) ) ) )]"
									size = { 100% 100% }
									tooltipwidget = {
										widget_maa_type_container_tooltip = {
											datacontext = "[MenAtArmsTypeViewTypeItem.GetMenAtArmsType]"
											blockoverride "maa_texture" {
												texture = "[MenAtArmsType.GetHorizontalImageForCulture( GetPlayer.GetCulture )]"
											}
										}
									}
									using = tooltip_ws
									enabled = "[And( And( MenAtArmsTypeViewTypeItem.CanCreate, And( And( IsGamePaused, Not( GetVariableSystem.Exists( 'maam_rt_busy' ) ) ), GetScriptedGui('maam_rt_can_price_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), EqualTo_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_rt_name_matches' ).CountVisibleChildren, '(int32)1' ) )]"
									onclick = "[GetVariableSystem.Set( 'maam_rt_busy', 'yes' )]"
									onclick = "[GetVariableSystem.Set( 'maam_rt_reopen_gui', 'yes' )]"
									onclick = "[GetVariableSystem.Set( 'maam_rt_name', MenAtArmsTypeViewTypeItem.GetMenAtArmsType.GetNameNoTooltip )]"
									onclick = "[MenAtArmsTypeViewTypeItem.OnClick]"
									onclick = "[GetScriptedGui('maam_rt_pc_begin_tgt').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'name_unique', MakeScopeFlag( Select_CString( EqualTo_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_rt_name_matches' ).CountVisibleChildren, '(int32)1' ), 'yes', 'no' ) ) ).End )]"
									onclick = "[MenAtArmsTypeView.Create]"
									onclick = "[GetScriptedGui('maam_rt_pc_quote_tgt').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
							}

							# A display name is not an identity when two native rows share it.
							button_normal = {
								visible = "[Not( EqualTo_int32( PdxGuiWidget.AccessParent.FindChild( 'maam_rt_name_matches' ).CountVisibleChildren, '(int32)1' ) )]"
								size = { 100% 100% }
								enabled = no
								tooltip = "MAAM_RT_AMBIGUOUS_TT"
							}

							# Can't be bought: the price, on top, with the game's own reason.
							text_single = {
								visible = "[Not( MenAtArmsTypeViewTypeItem.CanCreate )]"
								parentanchor = right|vcenter
								position = { -8 0 }
								text = "[MenAtArmsType.GetCostString( GetPlayer )]"
								default_format = "#high"
								tooltip = "[MenAtArmsTypeViewTypeItem.GetCreateWarning]"

								background = {
									using = Status_Bad
									margin = { 3 1 }
								}
							}
						}
					}
						}
							}
						}
					}
				}

				# The price panel: as tall as its content, always at the bottom
				# (filled from the stored prices, so it is right even before the
				# selection is restored).
				vbox = {
					ignoreinvisible = yes
					name = "maam_rt_price_panel"
					layoutpolicy_horizontal = expanding
					margin = { 10 8 }

					background = { using = Background_Area_Dark }

					text_multi = {
						visible = "[Not( IsGamePaused )]"
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 410
						margin_top = 40
						margin_bottom = 40
						align = center
						text = "MAAM_RT_PAUSE_FIRST"
					}

			vbox = {
				ignoreinvisible = yes
				visible = "[And( IsGamePaused, GetPlayer.MakeScope.Var('maam_rt_parity').IsSet )]"
				layoutpolicy_horizontal = expanding
				spacing = 6

				text_multi = {
					visible = "[GetPlayer.MakeScope.Var('maam_rt_tgt_refused').IsSet]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 410
