								spriteborder = { 2 2 }
								tintcolor = { 0.20 0.21 0.23 1 }
							}

							widget = {
								position = { 2 2 }
								size = { 80 44 }
								alpha = 0.6
								alwaystransparent = yes

								background = {
									texture = "[MenAtArmsType.GetHorizontalImageForCulture( GetPlayer.GetCulture )]"
									fittype = centercrop
								}
								background = {
									texture = "gfx/interface/component_tiles/tile_vignette_3px.dds"
									spriteType = Corneredtiled
									spriteborder = { 5 5 }
								}
							}

							text_single = {
								parentanchor = left|vcenter
								position = { 92 0 }
								max_width = 210
								text = "MAAM_RT_CUR_ROW"
								default_format = "#weak"
								fontsize_min = 11
								elide = right
								alwaystransparent = yes
							}

							text_single = {
								visible = "[MenAtArmsTypeViewTypeItem.CanCreate]"
								parentanchor = right|vcenter
								position = { -8 0 }
								text = "[MenAtArmsType.GetCostString( GetPlayer )]"
								default_format = "#weak"
								alwaystransparent = yes
							}

							# When the armory opens (paused), step 1: temporary resources, so even a
							# type you can't afford right now can be bought for its price check.
							widget = {
								visible = "[And( And( And( And( And( GetVariableSystem.Exists( 'maam_rt_window_ready' ), Not( GetScriptedGui('maam_rt_src_known_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetVariableSystem.Exists( 'maam_rt_busy' ) ) ), IsGamePaused ), GetScriptedGui('maam_rt_can_price_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), Not( GetVariableSystem.Exists( 'maam_rt_boost_gui' ) ) )]"
								size = { 1 1 }

								state = {
									name = _show
									on_start = "[GetVariableSystem.Set( 'maam_rt_boost_gui', 'yes' )]"
									on_start = "[GetScriptedGui('maam_rt_boost_now').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
							}
							# Step 2, one screen update later (the window's can-buy check is from the
							# previous update): price this type alone in its step, then remove them.
							widget = {
								visible = "[And( And( And( And( And( And( GetVariableSystem.Exists( 'maam_rt_window_ready' ), Not( GetScriptedGui('maam_rt_src_known_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetVariableSystem.Exists( 'maam_rt_busy' ) ) ), IsGamePaused ), GetScriptedGui('maam_rt_can_price_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), GetVariableSystem.Exists( 'maam_rt_boost_gui' ) ), GetScriptedGui('maam_rt_boosted_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								size = { 1 1 }

								state = {
