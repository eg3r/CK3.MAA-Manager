									on_start = "[GetVariableSystem.Clear( 'maam_rt_boost_gui' )]"
									on_start = "[MenAtArmsTypeViewTypeItem.OnClick]"
									on_start = "[GetVariableSystem.Set( 'maam_rt_busy', 'yes' )]"
									on_start = "[GetVariableSystem.Set( 'maam_rt_src_check_gui', 'yes' )]"
									on_start = "[GetScriptedGui('maam_rt_pc_begin_src').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'real_relation', MakeScopeFlag( 'same' ) ).End )]"
									on_start = "[MenAtArmsTypeView.Create]"
									on_start = "[GetScriptedGui('maam_rt_pc_quote_src_auto').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
								}
							}
						}
					}
