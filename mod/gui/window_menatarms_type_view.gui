
######################################################
################# ADD MEN-AT-ARMS ####################
######################################################

# MAA Manager: native CK3 1.20.0.3 recruitment window (GENERATED by tests/tools/gui_gen/
# gen_rt_gui.py). Normal recruitment is unchanged. While a Men-at-Arms Manager
# retrain is open (player variable maam_rt_active) the window is the armory:
# clicking a type reads its exact fee with a background purchase that is
# refunded in the same click, and Retrain buys it for real and commits.
# The purchase closes the window; the Military board reopens it at once.
# Normal recruitment stays vanilla: the window's states are the vanilla ones;
# on opening the mod only sets and clears its own GUI flags (no game command,
# no animation change).
window = {
	name = "menatarmstype_view"
	parentanchor = top|right
	position = { -610 70 }
	size = { 470 880 }
	movable = no
	layer = middle

	using = Window_Background
	using = Window_Decoration

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		position_x = -610
		on_start = "[GetVariableSystem.Set( 'menatarms_details_open', 'true'  )]"
		# MAA Manager: end the retrain click guards (GUI flags only; a child
		# widget's _show does not fire when the window opens, so they live here).
		on_start = "[GetVariableSystem.Clear( 'maam_rt_busy' )]"
		on_start = "[GetVariableSystem.Clear( 'maam_rt_reopen_gui' )]"
		# 'Window ready': off while opening, on when the fade-in ends. Helpers in
		# the rows include it, so their condition always turns from false to true
		# while the window is up (_show only fires on such a change; on the first
		# open a new row would otherwise start out true and never fire).
		on_start = "[GetVariableSystem.Clear( 'maam_rt_window_ready' )]"
		on_start = "[GetVariableSystem.Clear( 'maam_rt_boost_gui' )]"
		on_finish = "[GetVariableSystem.Set( 'maam_rt_window_ready', 'yes' )]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		position_x = -580
		on_start = "[GetVariableSystem.Clear( 'menatarms_details_open' )]"
	}

	vbox = {
		ignoreinvisible = yes
		using = Window_Margins
		set_parent_size_to_minimum = yes

		state = {
			name = "menatarms_details_refresh"
			alpha = 0
			duration = 0.2
			next = "b"
			using = Animation_Curve_Default
		}

		state = {
			name = "b"
			alpha = 1
			duration = 0.2
			using = Animation_Curve_Default
		}

		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text"
			{
				# Normal recruitment reads the vanilla title directly (SelectLocalization
				# would lose the window's data); a retrain shows a fixed title.
				text = "[Select_CString( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, Localize( 'MAAM_RT_PICKER_TITLE' ), MenAtArmsTypeView.GetTitle )]"
			}

			blockoverride "button_close"
			{
				# Retrain mode: closing the armory cancels (nothing is held).
				onclick = "[GetScriptedGui('maam_rt_cancel').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'why', MakeScopeFlag( 'closed' ) ).End )]"
				onclick = "[GetVariableSystem.Clear( 'maam_rt_busy' )]"
				onclick = "[GetVariableSystem.Clear( 'maam_rt_reopen_gui' )]"
				onclick = "[GetVariableSystem.Clear( 'maam_rt_commit_gui' )]"
				onclick = "[MenAtArmsTypeView.Close]"
			}
		}

		# Armory: the regiment being retrained, in a fixed box. Nothing in it
		# (the price line's icon, the plumbing below) can move the list or the
		# panel when the first pick reads the price.
		widget = {
			visible = "[GetPlayer.MakeScope.Var('maam_rt_active').IsSet]"
			size = { 430 72 }

			# Cancel only an interrupted pre-purchase resource loan.
			widget = {
				size = { 0 0 }
				state = {
					name = maam_rt_interrupted_boost
					trigger_when = "[And( GetPlayer.MakeScope.Var('maam_rt_boost_waiting').IsSet, Or( Not( IsGamePaused ), Not( GetScriptedGui('maam_rt_can_price_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) )]"
					on_start = "[GetScriptedGui('maam_rt_cancel_waiting_boost').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
			}

			# Armory plumbing: a click that bought nothing.
			widget = {
				size = { 1 1 }

				state = {
					name = maam_rt_nothing
					trigger_when = "[GetPlayer.MakeScope.Var('maam_rt_nothing').IsSet]"
					on_start = "[GetVariableSystem.Clear( 'maam_rt_busy' )]"
					on_start = "[GetVariableSystem.Clear( 'maam_rt_reopen_gui' )]"
					on_start = "[GetVariableSystem.Clear( 'maam_rt_commit_gui' )]"
					on_start = "[GetVariableSystem.Clear( 'maam_rt_src_check_gui' )]"
					on_start = "[GetScriptedGui('maam_rt_nothing_ack').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				}
			}

			# Armory: the regiment being retrained (hover: the game's regiment tooltip).
			hbox = {
				ignoreinvisible = yes
				datacontext = "[GetPlayer.MakeScope.Var('maam_rt_source').Regiment]"
				size = { 100% 100% }
				margin = { 10 6 }
				spacing = 10
				tooltipwidget = {
					using = regiment_container_text_tooltip
				}
				using = tooltip_ws

				background = { using = Background_Area_Dark }

				widget = {
					size = { 84 50 }

					background = {
						texture = "[Regiment.GetMAAType.GetHorizontalImageForCulture( GetPlayer.GetCulture )]"
						fittype = centercrop
					}
					background = {
						texture = "gfx/interface/component_tiles/tile_vignette_3px.dds"
						spriteType = Corneredtiled
						spriteborder = { 5 5 }
					}
				}

				vbox = {
					ignoreinvisible = yes
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					expand = {}
					# Line 1: the regiment's name.
					text_single = {
						layoutpolicy_horizontal = expanding
						align = left|nobaseline
						text = "[Regiment.GetNameNoTooltip]"
						default_format = "#high"
						using = Font_Size_Medium
						max_width = 310
						elide = right
					}
					# Line 2: stacks and type, then the price (or why it can't be read).
					hbox = {
						ignoreinvisible = yes
						layoutpolicy_horizontal = expanding
						spacing = 0

						text_single = {
							align = left|nobaseline
							text = "MAAM_RT_CUR_INFO"
							max_width = 190
							elide = right
						}
						# Two copies swapped after every price check (redraw with new values).
						hbox = {
							ignoreinvisible = yes
							visible = "[GetPlayer.MakeScope.Var('maam_rt_parity').IsSet]"
							text_single = {
								visible = "[GetPlayer.MakeScope.Var('maam_rt_src_price').IsSet]"
								align = left|nobaseline
								text = "MAAM_RT_CUR_PRICE"
								tooltip = "MAAM_RT_CUR_PRICE_TT"
								max_width = 130
								elide = right
							}
							text_single = {
								visible = "[GetScriptedGui('maam_rt_src_unbuyable_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'unlisted' ) ).End )]"
								align = left|nobaseline
								text = "MAAM_RT_CUR_UNLISTED"
								tooltip = "MAAM_RT_CUR_UNLISTED_TT"
								max_width = 130
								elide = right
							}
							text_single = {
								visible = "[GetScriptedGui('maam_rt_src_unbuyable_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'refused' ) ).End )]"
								align = left|nobaseline
								text = "MAAM_RT_CUR_REFUSED"
								tooltip = "MAAM_RT_CUR_REFUSED_TT"
								max_width = 130
								elide = right
							}
							text_single = {
								visible = "[GetScriptedGui('maam_rt_src_unbuyable_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'nongold' ) ).End )]"
								align = left|nobaseline
								text = "MAAM_RT_CUR_NONGOLD"
								tooltip = "MAAM_RT_CUR_NONGOLD_TT"
								max_width = 130
								elide = right
							}
							text_single = {
								visible = "[Not( GetScriptedGui('maam_rt_src_known_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								align = left|nobaseline
								text = "MAAM_RT_CUR_UNKNOWN"
								tooltip = "MAAM_RT_CUR_UNKNOWN_TT"
								max_width = 130
								elide = right
							}
					}
						hbox = {
							ignoreinvisible = yes
							visible = "[Not( GetPlayer.MakeScope.Var('maam_rt_parity').IsSet )]"
							text_single = {
								visible = "[GetPlayer.MakeScope.Var('maam_rt_src_price').IsSet]"
								align = left|nobaseline
								text = "MAAM_RT_CUR_PRICE"
								tooltip = "MAAM_RT_CUR_PRICE_TT"
								max_width = 130
								elide = right
							}
							text_single = {
								visible = "[GetScriptedGui('maam_rt_src_unbuyable_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'unlisted' ) ).End )]"
								align = left|nobaseline
								text = "MAAM_RT_CUR_UNLISTED"
								tooltip = "MAAM_RT_CUR_UNLISTED_TT"
								max_width = 130
								elide = right
							}
							text_single = {
								visible = "[GetScriptedGui('maam_rt_src_unbuyable_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'refused' ) ).End )]"
								align = left|nobaseline
								text = "MAAM_RT_CUR_REFUSED"
								tooltip = "MAAM_RT_CUR_REFUSED_TT"
								max_width = 130
								elide = right
							}
							text_single = {
								visible = "[GetScriptedGui('maam_rt_src_unbuyable_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'nongold' ) ).End )]"
								align = left|nobaseline
								text = "MAAM_RT_CUR_NONGOLD"
								tooltip = "MAAM_RT_CUR_NONGOLD_TT"
								max_width = 130
								elide = right
							}
							text_single = {
								visible = "[Not( GetScriptedGui('maam_rt_src_known_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
								align = left|nobaseline
								text = "MAAM_RT_CUR_UNKNOWN"
								tooltip = "MAAM_RT_CUR_UNKNOWN_TT"
								max_width = 130
								elide = right
							}
					}
						expand = {}
					}
					text_single = {
						visible = "[Regiment.GetOriginProvince.IsValid]"
						layoutpolicy_horizontal = expanding
						align = left|nobaseline
						text = "MAAM_RT_CUR_STATIONED"
						tooltip = "MAAM_RT_CUR_STATIONED"
						using = Font_Size_Small
						max_width = 310
						elide = right
					}
					expand = {}
				}
			}
		}

		# Armory: role filter, in a fixed box. All types stays put; the roles (your
		# current role first) scroll sideways when there are more than fit, with
		# the scrollbar under them (the box keeps its height either way).
		widget = {
			visible = "[GetPlayer.MakeScope.Var('maam_rt_active').IsSet]"
			size = { 430 52 }

			hbox = {
				ignoreinvisible = yes
				size = { 100% 100% }
				margin = { 10 2 }
				margin_top = 6
				spacing = 3

				vbox = {
					ignoreinvisible = yes
					layoutpolicy_vertical = expanding

					# All types: down while no role filter is set (the state on opening).
					maam_btn = {
						size = { 52 32 }
						text = "MAAM_RT_ROLE_ALL"
						down = "[Not( GetVariableSystem.Exists( 'maam_rt_role' ) )]"
						tooltip = "MAAM_RT_ROLE_ALL_TT"
						onclick = "[GetVariableSystem.Clear( 'maam_rt_role' )]"
					}
					expand = {}
				}

				vbox = {
					ignoreinvisible = yes
					layoutpolicy_vertical = expanding

					widget = {
						size = { 1 32 }

						widget = {
							parentanchor = vcenter
							size = { 1 24 }
							background = {
								texture = "gfx/interface/colors/white.dds"
								alpha = 0.25
							}
						}
					}
					expand = {}
				}

				# The game's own sideways list (interaction_call_ally_notification_window):
				# a plain scrollarea, the row straight in its scrollwidget. No
				# set_parent_size_to_minimum here: inside the layout it looped the
				# layout until the game crashed (stack overflow, 2026-10-06).
				scrollarea = {
					name = "maam_rt_roles"
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 44 }
					maximumsize = { -1 44 }
					scrollbarpolicy_vertical = always_off
					scrollbarpolicy_horizontal = as_needed

					scrollbar_horizontal = {
						using = Scrollbar_Horizontal
					}

					scrollwidget = {
						vbox = {
							ignoreinvisible = yes
							hbox = {
								ignoreinvisible = yes
								layoutpolicy_horizontal = expanding
								spacing = 0

								hbox = {
									ignoreinvisible = yes
									datamodel = "[MenAtArmsTypeView.GetMenAtArmsTypes]"
									spacing = 0

									item = {
					hbox = {
						ignoreinvisible = yes
						datacontext = "[MenAtArmsTypeViewTypeItem.GetMenAtArmsType]"
						spacing = 0

						hbox = {
							ignoreinvisible = yes
							name = "maam_role_earlier"
							datamodel = "[MenAtArmsTypeView.GetMenAtArmsTypes]"

							item = {
								widget = {
									size = { 0 0 }
									visible = "[And( And( EqualTo_string( MenAtArmsTypeViewTypeItem.GetMenAtArmsType.GetBaseTypeName, MenAtArmsType.GetBaseTypeName ), LessThan_int32( PdxGuiWidget.GetIndexInDataModel, PdxGuiWidget.AccessParent.AccessParent.GetIndexInDataModel ) ), And( Not( ObjectsEqual( MenAtArmsTypeViewTypeItem.GetMenAtArmsType, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType ) ), MenAtArmsTypeViewTypeItem.CanCreate ) )]"
								}
							}
						}
						hbox = {
							ignoreinvisible = yes
							name = "maam_role_count"
							datamodel = "[MenAtArmsTypeView.GetMenAtArmsTypes]"

							item = {
								widget = {
									size = { 0 0 }
									visible = "[And( EqualTo_string( MenAtArmsTypeViewTypeItem.GetMenAtArmsType.GetBaseTypeName, MenAtArmsType.GetBaseTypeName ), And( Not( ObjectsEqual( MenAtArmsTypeViewTypeItem.GetMenAtArmsType, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType ) ), MenAtArmsTypeViewTypeItem.CanCreate ) )]"
								}
							}
						}

						widget = {
							visible = "[And( And( EqualTo_int32( PdxGuiWidget.AccessParent.FindChild( 'maam_role_earlier' ).CountVisibleChildren, '(int32)0' ), And( Not( ObjectsEqual( MenAtArmsTypeViewTypeItem.GetMenAtArmsType, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType ) ), MenAtArmsTypeViewTypeItem.CanCreate ) ), EqualTo_string( MenAtArmsType.GetBaseTypeName, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType.GetBaseTypeName ) )]"
							size = { 39 32 }

							button_standard = {
								visible = "[Not( GetVariableSystem.HasValue( 'maam_rt_role', MenAtArmsType.GetBaseTypeName ) )]"
								size = { 36 32 }
								tooltip = "MAAM_RT_ROLE_TT"
								onclick = "[GetVariableSystem.Set( 'maam_rt_role', MenAtArmsType.GetBaseTypeName )]"
							}
							button_standard = {
								visible = "[GetVariableSystem.HasValue( 'maam_rt_role', MenAtArmsType.GetBaseTypeName )]"
								size = { 36 32 }
								down = yes
								tooltip = "MAAM_RT_ROLE_ON_TT"
								onclick = "[GetVariableSystem.Clear( 'maam_rt_role' )]"
							}
							icon = {
								position = { 6 4 }
								size = { 24 24 }
								texture = "[MenAtArmsType.GetIcon]"
								alwaystransparent = yes
							}
							icon = {
								size = { 36 32 }
								texture = "gfx/interface/component_tiles/tile_selected.dds"
								spriteType = Corneredtiled
								spriteborder = { 8 8 }
								alwaystransparent = yes
							}
							text_single = {
								parentanchor = bottom|right
								position = { -6 0 }
								text = "[PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_role_count' ).CountVisibleChildren]"
								default_format = "#high"
								using = Font_Size_Small
								alwaystransparent = yes
							}
						}
					}
									}
								}

								hbox = {
									ignoreinvisible = yes
									datamodel = "[MenAtArmsTypeView.GetMenAtArmsTypes]"
									spacing = 0

									item = {
					hbox = {
						ignoreinvisible = yes
						datacontext = "[MenAtArmsTypeViewTypeItem.GetMenAtArmsType]"
						spacing = 0

						hbox = {
							ignoreinvisible = yes
							name = "maam_role_earlier"
							datamodel = "[MenAtArmsTypeView.GetMenAtArmsTypes]"

							item = {
								widget = {
									size = { 0 0 }
									visible = "[And( And( EqualTo_string( MenAtArmsTypeViewTypeItem.GetMenAtArmsType.GetBaseTypeName, MenAtArmsType.GetBaseTypeName ), LessThan_int32( PdxGuiWidget.GetIndexInDataModel, PdxGuiWidget.AccessParent.AccessParent.GetIndexInDataModel ) ), And( Not( ObjectsEqual( MenAtArmsTypeViewTypeItem.GetMenAtArmsType, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType ) ), MenAtArmsTypeViewTypeItem.CanCreate ) )]"
								}
							}
						}
						hbox = {
							ignoreinvisible = yes
							name = "maam_role_count"
							datamodel = "[MenAtArmsTypeView.GetMenAtArmsTypes]"

							item = {
								widget = {
									size = { 0 0 }
									visible = "[And( EqualTo_string( MenAtArmsTypeViewTypeItem.GetMenAtArmsType.GetBaseTypeName, MenAtArmsType.GetBaseTypeName ), And( Not( ObjectsEqual( MenAtArmsTypeViewTypeItem.GetMenAtArmsType, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType ) ), MenAtArmsTypeViewTypeItem.CanCreate ) )]"
								}
							}
						}

						widget = {
							visible = "[And( And( EqualTo_int32( PdxGuiWidget.AccessParent.FindChild( 'maam_role_earlier' ).CountVisibleChildren, '(int32)0' ), And( Not( ObjectsEqual( MenAtArmsTypeViewTypeItem.GetMenAtArmsType, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType ) ), MenAtArmsTypeViewTypeItem.CanCreate ) ), Not( EqualTo_string( MenAtArmsType.GetBaseTypeName, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType.GetBaseTypeName ) ) )]"
							size = { 39 32 }

							button_standard = {
								visible = "[Not( GetVariableSystem.HasValue( 'maam_rt_role', MenAtArmsType.GetBaseTypeName ) )]"
								size = { 36 32 }
								tooltip = "MAAM_RT_ROLE_TT"
								onclick = "[GetVariableSystem.Set( 'maam_rt_role', MenAtArmsType.GetBaseTypeName )]"
							}
							button_standard = {
								visible = "[GetVariableSystem.HasValue( 'maam_rt_role', MenAtArmsType.GetBaseTypeName )]"
								size = { 36 32 }
								down = yes
								tooltip = "MAAM_RT_ROLE_ON_TT"
								onclick = "[GetVariableSystem.Clear( 'maam_rt_role' )]"
							}
							icon = {
								position = { 6 4 }
								size = { 24 24 }
								texture = "[MenAtArmsType.GetIcon]"
								alwaystransparent = yes
							}
							text_single = {
								parentanchor = bottom|right
								position = { -6 0 }
								text = "[PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_role_count' ).CountVisibleChildren]"
								default_format = "#high"
								using = Font_Size_Small
								alwaystransparent = yes
							}
						}
					}
									}
								}

								expand = {}
							}
							expand = {}
						}
					}
				}
			}
		}

		# Normal recruitment: the vanilla list (grows up to 340).
		scrollbox = {
			name = "attending_scrollarea"
			visible = "[Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet )]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			size = { 430 0 }
			maximumsize = { -1 340 }
			autoresizescrollarea = yes

			blockoverride "scrollbox_content"
			{
				vbox = {
					ignoreinvisible = yes
					layoutpolicy_horizontal = expanding
					spacing = 3

					# Normal recruitment: the vanilla rows.
					vbox = {
						ignoreinvisible = yes
						name = "types_grid"
						visible = "[Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet )]"
						datamodel = "[MenAtArmsTypeView.GetMenAtArmsTypes]"
						layoutpolicy_horizontal = expanding
						spacing = 3

						item = {
							button_standard = {
								name = "select"
								datacontext = "[MenAtArmsTypeViewTypeItem.GetMenAtArmsType]"
								layoutpolicy_horizontal = expanding
								size = { 0 42 }

								down = "[MenAtArmsTypeViewTypeItem.IsSelected]"

								hbox = {
									ignoreinvisible = yes
									margin = { 10 0 }
									spacing = 10

									highlight_icon = {
										name = "men_at_arms_icon"
										size = { 35 35 }
										texture = "[MenAtArmsType.GetIcon]"
									}

									text_single = {
										name = "men_at_arms_name"
										layoutpolicy_horizontal = expanding
										text = "[MenAtArmsType.GetNameNoTooltip]"
										default_format = "#high"
									}

									text_single = {
										name = "men_at_arms_cost"
										text = "[Select_CString( MenAtArmsTypeView.GetSelectedTitle.IsValid, MenAtArmsType.GetTitleRegimentCostString( GetPlayer ), MenAtArmsType.GetCostString( GetPlayer ) )]"
										default_format = "#high"

										tooltip = "[MenAtArmsTypeViewTypeItem.GetCreateWarning]"
										tooltip_visible = "[Not(MenAtArmsTypeViewTypeItem.CanCreate)]"

										background = {
											visible = "[Not(MenAtArmsTypeViewTypeItem.CanCreate)]"

											using = Status_Bad
										}
									}
								}

								button_normal = {
									visible = "[Not(MenAtArmsTypeView.IsAnyMenAtArmsTypeSelected)]"
									size = { 100% 100% }
									onclick = "[MenAtArmsTypeViewTypeItem.OnClick]"
								}

								button_normal = {
									visible = "[MenAtArmsTypeView.IsAnyMenAtArmsTypeSelected]"
									size = { 100% 100% }
									onclick = "[PdxGuiTriggerAllAnimations('add_maa_change')]"

									state = {
										name = _mouse_click
										delay = 0.2
										on_finish = "[MenAtArmsTypeViewTypeItem.OnClick]"
									}
								}
							}
						}
					}

				}
			}
		}

		# Armory: the type list and the price panel share one fixed height, so
		# the window never changes size. The panel sits at the bottom, as tall
		# as its content; the list fills the rest (a shorter panel shows more
		# rows; the rows themselves never move).
		widget = {
			visible = "[GetPlayer.MakeScope.Var('maam_rt_active').IsSet]"
			size = { 430 620 }

			vbox = {
				ignoreinvisible = yes
				size = { 100% 100% }

				scrollbox = {
					name = "maam_rt_types"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					blockoverride "scrollbox_margins"
					{
						margin_left = 0
						margin_right = 14
						margin_top = 2
						margin_bottom = 2
					}
					blockoverride "scrollbox_background" {}

					blockoverride "scrollbox_content"
					{
						vbox = {
							layoutpolicy_horizontal = expanding

							# The current type first while its price is read (it carries the check).
							vbox = {
								datamodel = "[MenAtArmsTypeView.GetMenAtArmsTypes]"
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes

								item = {
							widget = {
						datacontext = "[MenAtArmsTypeViewTypeItem.GetMenAtArmsType]"
						visible = "[And( ObjectsEqual( MenAtArmsType.Self, GetPlayer.MakeScope.Var('maam_rt_source').Regiment.GetMAAType ), Not( GetScriptedGui('maam_rt_src_known_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
						layoutpolicy_horizontal = expanding
						size = { 0 50 }

						widget = {
							size = { 100% 48 }
							tooltip = "MAAM_RT_CUR_ROW_TT"

							background = {
