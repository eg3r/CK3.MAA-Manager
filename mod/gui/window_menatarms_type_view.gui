					visible = "[And( Not( GetScriptedGui('maam_rt_quoted_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), Not( GetPlayer.MakeScope.Var('maam_rt_tgt_refused').IsSet ) )]"
