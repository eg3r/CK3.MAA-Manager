			# Row end: idle ⇄ and ↻, or Place during a stack move.
			hbox = {
				ignoreinvisible = yes
				name = "maam_lane_end"
				spacing = 0

				hbox = {
					ignoreinvisible = yes
					name = "maam_can_give"
					datamodel = "[MilitaryItem.GetOwnedMaa]"

					item = {
						widget = {
							size = { 0 0 }
							visible = "[And( And( ObjectsEqual( Regiment.GetMAAType, MenAtArmsType.Self ), Or( Regiment.IsPersonal, ObjectsEqual( Regiment.GetOwningTitle, Regiment.GetControllingTitle ) ) ), GreaterThan_int32( Regiment.CalcMenAliveCount, Divide_int32( Regiment.GetMaxCount, Regiment.GetMAAChunkCount ) ) )]"
						}
					}
