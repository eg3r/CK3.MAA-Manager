######################################################
# Men-At-Arms Manager - Order of Battle (design v5.10)
# GENERATED by tests/tools/gui_gen/gen_ob_gui.py from maam_ob_types.tpl.gui:
# edit the template or generator, then run it again.
#
# Only the Men-at-Arms block of the Military window is redrawn; the native
# shell (header, tabs, levies, knights, upkeep) is untouched.
# - Width budget: the native Men-at-Arms area is about 505 px wide (its tile
#   grid is 3 x 169). Lanes need 380 px, 475 px with the Merge here chip.
# - Stack moves are immediate; a lift never moves the last stack. When only the
#   standard is left, every lane that can take it shows the red Merge here at
#   its start (Place sits at the lane end, never the same spot).
# - A lane's name always opens the native regiment window (not while a
#   retrain is open: then the left side belongs to the armory).
# - No board button carries the Enter/confirm shortcut.
# - Outlines use frame_1px/frame_2px (white, tinted per state).
######################################################

types MAAManagerOrderOfBattle
{
	# Gold button WITHOUT the confirm shortcut (button_primary binds Enter).
	type maam_button_gold = button_standard
	{
		clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_confirm"

		background = {
			texture = "gfx/interface/buttons/button_standard.dds"
			framesize = { 252 80 }
			frame = 4
		}

		buttonText = {
			text_single = {
				size = { 100% 100% }
				autoresize = no
				margin = { 8 0 }
				align = center|nobaseline
				default_format = "#high"
				alwaystransparent = yes
			}
		}

		blockoverride "button_pattern" {}

		icon = {
			size = { 100% 100% }
			texture = "gfx/interface/colors/black.dds"
			alpha = 0.2
			using = Mask_Rough_Edges

			modify_texture = {
				texture = "gfx/interface/skinned/mask_pattern.dds"
				blend_mode = alphaMultiply
				spriteType = Corneredtiled
				texture_density = 3
			}
		}
	}

	# Compact standard button for the strip (outlined in the concept).
	type maam_btn = button_standard
	{
		size = { 80 24 }

		buttonText = {
			text_single = {
				size = { 100% 100% }
				autoresize = no
				margin = { 4 0 }
				align = center|nobaseline
				default_format = "#clickable"
				using = Font_Size_Small
				fontsize_min = 10
				alwaystransparent = yes
			}
		}
	}

	# Strip toolbar button: a gold flat icon at the left, the label after it.
	type maam_btn_icon = button_standard
	{
		size = { 104 24 }

		buttonText = {
			text_single = {
				size = { 100% 100% }
				autoresize = no
				margin = { 6 0 }
				margin_left = 26
				align = left|nobaseline
				default_format = "#clickable"
				using = Font_Size_Small
				fontsize_min = 10
				alwaystransparent = yes
			}
		}

		icon_flat_standard_gold = {
			parentanchor = vcenter|left
			position = { 7 0 }
			size = { 16 16 }
			alwaystransparent = yes
			block "maam_btn_icon" {
				texture = "gfx/interface/icons/flat_icons/replace.dds"
			}
		}
	}

	# Men-at-Arms action button (Create, Recruit from Subjects, refill ...): the
	# native button, sharing one row; the text shrinks to fit and stays clear
	# of the icon at its left.
	type maam_action_btn = button_standard
	{
		buttonText = {
			text_single = {
				size = { 100% 100% }
				autoresize = no
				margin = { 34 0 }
				align = center|nobaseline
				default_format = "#clickable"
				fontsize_min = 11
				alwaystransparent = yes
			}
		}
	}

	# Text link (Next tip, Ask again).
	type maam_link = widget
	{
		size = { 64 24 }

		text_single = {
			parentanchor = vcenter|left
			block "maam_link_text" {
				text = "MAAM_QM_ASK"
			}
			default_format = "#clickable"
			using = Font_Size_Small
			alwaystransparent = yes
		}

		button_normal = {
			size = { 100% 100% }
			clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
			block "maam_link_button" {}
		}
	}

	# Green outlined chip (Place, This one): never destructive.
	type maam_chip = widget
	{
		size = { 66 24 }

		background = {
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.12 0.21 0.13 0.95 }
		}
		background = {
			texture = "gfx/interface/icons/maam/frame_1px.dds"
			spriteType = Corneredtiled
			spriteborder = { 2 2 }
			tintcolor = { 0.42 0.74 0.45 1 }
		}

		text_single = {
			parentanchor = center
			align = center|nobaseline
			block "maam_chip_text" {
				text = "MAAM_PLACE"
			}
			default_format = "#high"
			using = Font_Size_Small
			max_width = 62
			fontsize_min = 10
			alwaystransparent = yes
		}

		button_normal = {
			size = { 100% 100% }
			clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
			block "maam_chip_button" {}
		}
	}

	# Red chip (Merge here, Merge last stack): destructive, never where Place was.
	type maam_red_chip = widget
	{
		size = { 108 24 }

		background = {
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.30 0.11 0.09 0.95 }
		}
		background = {
			texture = "gfx/interface/icons/maam/frame_1px.dds"
			spriteType = Corneredtiled
			spriteborder = { 2 2 }
			tintcolor = { 0.85 0.36 0.29 1 }
		}

		hbox = {
			ignoreinvisible = yes
			size = { 100% 100% }
			margin = { 4 0 }
			spacing = 3

			icon_flat_standard_gold = {
				size = { 16 16 }
				texture = "gfx/interface/icons/flat_icons/army_merge.dds"
				alwaystransparent = yes
			}
			text_single = {
				block "maam_chip_text" {
					text = "MAAM_MERGE_HERE"
				}
				block "maam_chip_text_width" {
					max_width = 80
				}
				default_format = "#high"
				using = Font_Size_Small
				align = left|nobaseline
				fontsize_min = 14
				elide = right
				alwaystransparent = yes
			}
			expand = {}
		}

		button_normal = {
			size = { 100% 100% }
			clicksound = "event:/SFX/UI/Unit/Army/sfx_ui_unit_army_merge"
			block "maam_chip_button" {}
		}
	}

	# Status badge: fixed 22 x 18, a coloured glyph in a tinted frame; the
	# tooltip names the status (Unstationed, Unraised, Retraining, Loaned).
	type maam_badge = widget
	{
		size = { 22 18 }
		using = tooltip_se

		background = {
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.09 0.09 0.10 0.9 }
		}
		background = {
			texture = "gfx/interface/icons/maam/frame_1px.dds"
			spriteType = Corneredtiled
			spriteborder = { 2 2 }
			block "maam_badge_frame" {
				tintcolor = { 0.80 0.33 0.27 1 }
			}
		}

		block "maam_badge_icon" {
			icon_flat_standard_red = {
				parentanchor = center
				size = { 16 16 }
				texture = "gfx/interface/icons/flat_icons/unpin.dds"
			}
		}
	}

	######################################################
	# Lane (Regiment datacontext from MilitaryItem.GetOwnedMaa)
	# icon | [Merge here] | name + status | pieces filled with soldiers | end
	######################################################
	type maam_ob_lane = widget
	{
		datacontext = "[Regiment.GetMAAType]"
		layoutpolicy_horizontal = expanding
		size = { 0 36 }
		maximumsize = { 507 36 }
		alpha = "[Select_float( Or( And( GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Not( Or( GetScriptedGui('maam_ob_is_src').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), Or( And( And( GetScriptedGui('maam_ob_lane_receive').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) ), Or( And( And( GetScriptedGui('maam_ob_lane_merge').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) ), GetScriptedGui('maam_ob_lane_pour_picked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ) ) ) ) ), And( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, Not( GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ) ) ), '(float)0.5', '(float)1.0' )]"

		background = {
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.115 0.122 0.135 0.95 }
		}
		# Its regiment window is open: a lighter lane (and the edge bar below).
		background = {
			visible = "[Regiment.IsShownInMaaView]"
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.165 0.172 0.188 0.95 }
		}
		background = {
			visible = "[And( And( GetScriptedGui('maam_ob_lane_receive').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.30 0.55 0.32 0.12 }
		}
		background = {
			visible = "[And( And( GetScriptedGui('maam_ob_lane_merge').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.62 0.20 0.16 0.16 }
		}
		background = {
			texture = "gfx/interface/icons/maam/frame_1px.dds"
			spriteType = Corneredtiled
			spriteborder = { 2 2 }
			tintcolor = { 0.27 0.28 0.30 1 }
		}
		background = {
			visible = "[Or( Or( GetScriptedGui('maam_ob_is_src').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), Or( GetScriptedGui('maam_qm_hl_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), GetScriptedGui('maam_ob_lane_pour_picked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ) )]"
			texture = "gfx/interface/icons/maam/frame_2px.dds"
			spriteType = Corneredtiled
			spriteborder = { 3 3 }
			tintcolor = { 0.85 0.74 0.50 1 }
		}
		background = {
			visible = "[And( And( GetScriptedGui('maam_ob_lane_receive').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
			texture = "gfx/interface/icons/maam/frame_2px.dds"
			spriteType = Corneredtiled
			spriteborder = { 3 3 }
			tintcolor = { 0.42 0.74 0.45 1 }
		}
		background = {
			visible = "[And( And( GetScriptedGui('maam_ob_lane_merge').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
			texture = "gfx/interface/icons/maam/frame_2px.dds"
			spriteType = Corneredtiled
			spriteborder = { 3 3 }
			tintcolor = { 0.80 0.33 0.27 1 }
		}

		# Its regiment window is open: a gold bar on the left edge, the side
		# where the window appears (design study A "Edge bar").
		widget = {
			visible = "[Regiment.IsShownInMaaView]"
			size = { 3 100% }
			alwaystransparent = yes

			background = {
				texture = "gfx/interface/colors/white.dds"
				tintcolor = { 0.79 0.66 0.42 1 }
			}
		}

		# A soldier move is open on another regiment of this type: join its
		# partner list (GUI type comparison, so any modded type works).
		widget = {
			visible = "[And( And( And( GetScriptedGui('maam_ob_kind_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'pour' ) ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), Not( GetScriptedGui('maam_ob_is_src').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ) ), Or( Regiment.IsPersonal, ObjectsEqual( Regiment.GetOwningTitle, Regiment.GetControllingTitle ) ) )]"
			size = { 0 0 }

			state = {
				name = _show
				on_start = "[GetScriptedGui('maam_ob_pour_register').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target_regiment', Regiment.MakeScope ).AddScope( 'type_relation', MakeScopeFlag( 'same' ) ).End )]"
			}
		}

		# A retrain owns the left side: close this regiment's window.
		state = {
			name = maam_close_on_retrain
			trigger_when = "[And( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, Regiment.IsShownInMaaView )]"
			on_start = "[Regiment.ToggleMaaView]"
		}

		hbox = {
			ignoreinvisible = yes
			size = { 100% 100% }
			margin_left = 6
			margin_right = 14
			spacing = 5

			icon = {
				size = { 24 24 }
				texture = "[MenAtArmsType.GetIcon]"
			}

			# Lane start: the red Merge here (last stack only).
			maam_red_chip = {
				visible = "[And( And( GetScriptedGui('maam_ob_lane_merge').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
				blockoverride "maam_chip_button" {
					tooltip = "MAAM_MERGE_HERE_TT"
					onclick = "[GetScriptedGui('maam_ob_merge').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target_regiment', Regiment.MakeScope ).AddScope( 'type_relation', MakeScopeFlag( 'same' ) ).AddScope( 'gui_room', MakeScopeFlag( Select_CString( LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ), 'yes', 'no' ) ) ).End )]"
				}
			}

			# Name: opens the native regiment window.
			widget = {
				layoutpolicy_horizontal = expanding
				size = { 0 32 }
				using = tooltip_es

				tooltipwidget = {
					using = maam_regiment_tooltip

					blockoverride "maam_status" {
						# Same style as the game's station line above it.
						hbox = {
							ignoreinvisible = yes
							visible = "[GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"
							layoutpolicy_horizontal = expanding
							margin = { 15 0 }

							text_multi = {
								text = "MAAM_TT_RETRAINING"
								default_format = "#weak"
								autoresize = yes
							}
							expand = {}
						}
						hbox = {
							ignoreinvisible = yes
							visible = "[And( Not( GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), And( Not( Regiment.IsPersonal ), Not( ObjectsEqual( Regiment.GetOwningTitle, Regiment.GetControllingTitle ) ) ) )]"
							layoutpolicy_horizontal = expanding
							margin = { 15 0 }

							text_multi = {
								text = "MAAM_TT_LOANED"
								default_format = "#weak"
								autoresize = yes
							}
							expand = {}
						}
					}

					blockoverride "extra_info" {
						divider_light = {
							layoutpolicy_horizontal = expanding
						}
						text_multi = {
							layoutpolicy_horizontal = expanding
							visible = "[Regiment.GetOwningTitle.IsValid]"
							text = "MAAM_LANE_TITLE_TT"
							margin = { 10 0 }
						}
						text_single = {
							layoutpolicy_horizontal = expanding
							text = "[SelectLocalization( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, 'MAAM_LANE_LOCKED_HINT', 'MAAM_LANE_CLICK_HINT' )]"
							margin = { 10 0 }
						}
					}
				}

				# Name (16 px, at most 1 px smaller: long names elide), then
				# one fixed-size status badge. Size and soldiers are the pieces.
				hbox = {
					ignoreinvisible = yes
					size = { 100% 100% }
					spacing = 4

					text_single = {
						visible = "[Not( And( And( GetScriptedGui('maam_ob_lane_merge').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) ) )]"
						text = "[Regiment.GetNameNoTooltip]"
						default_format = "#high"
						align = left|nobaseline
						fontsize = 16
						fontsize_min = 15
						max_width = 192
						elide = right
					}
					text_single = {
						visible = "[Not( Not( And( And( GetScriptedGui('maam_ob_lane_merge').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) ) ) )]"
						text = "[Regiment.GetNameNoTooltip]"
						default_format = "#high"
						align = left|nobaseline
						fontsize = 16
						fontsize_min = 15
						max_width = 92
						elide = right
					}
					maam_badge = {
						visible = "[GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"
						tooltip = "MAAM_BADGE_RETRAINING_TT"
						blockoverride "maam_badge_frame" {
							tintcolor = { 0.85 0.74 0.50 1 }
						}
						blockoverride "maam_badge_icon" {
							icon_flat_standard_gold = {
								parentanchor = center
								size = { 16 16 }
								texture = "gfx/interface/icons/flat_icons/replace.dds"
							}
						}
					}
					maam_badge = {
						visible = "[And( Not( GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), And( Not( Regiment.IsPersonal ), Not( ObjectsEqual( Regiment.GetOwningTitle, Regiment.GetControllingTitle ) ) ) )]"
						tooltip = "MAAM_BADGE_LOANED_TT"
						blockoverride "maam_badge_frame" {
							tintcolor = { 0.55 0.57 0.60 1 }
						}
						blockoverride "maam_badge_icon" {
							icon_flat_standard_gold = {
								parentanchor = center
								size = { 16 16 }
								texture = "gfx/interface/icons/flat_icons/title_troops.dds"
							}
						}
					}
					maam_badge = {
						visible = "[And( And( Not( GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), Not( And( Not( Regiment.IsPersonal ), Not( ObjectsEqual( Regiment.GetOwningTitle, Regiment.GetControllingTitle ) ) ) ) ), And( Not( Regiment.IsRaised ), GetPlayer.IsAtWar ) )]"
						tooltip = "MAAM_BADGE_UNRAISED_TT"
						blockoverride "maam_badge_frame" {
							tintcolor = { 0.80 0.33 0.27 1 }
						}
						blockoverride "maam_badge_icon" {
							icon_flat_standard_red = {
								parentanchor = center
								size = { 16 16 }
								texture = "gfx/interface/icons/flat_icons/army_raise_assigned.dds"
							}
						}
					}
					maam_badge = {
						visible = "[And( And( Not( GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), Not( And( Not( Regiment.IsPersonal ), Not( ObjectsEqual( Regiment.GetOwningTitle, Regiment.GetControllingTitle ) ) ) ) ), And( Not( And( Not( Regiment.IsRaised ), GetPlayer.IsAtWar ) ), And( Not( Regiment.GetOriginProvince.IsValid ), GetPlayer.HasDomainProvincesForMAAOrigin ) ) )]"
						tooltip = "MAAM_BADGE_UNSTATIONED_TT"
						blockoverride "maam_badge_frame" {
							tintcolor = { 0.80 0.33 0.27 1 }
						}
						blockoverride "maam_badge_icon" {
							icon_flat_standard_red = {
								parentanchor = center
								size = { 16 16 }
								texture = "gfx/interface/icons/flat_icons/unpin.dds"
							}
						}
					}
					expand = {}
				}

				# Native immediate path when no regiment window is open ...
				button_normal = {
					visible = "[And( Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ), Not( GetVariableSystem.Exists( 'menatarms_open' ) ) )]"
					size = { 100% 100% }
					onclick = "[Regiment.ToggleMaaView]"
				}
				# ... and the native delayed path while one is open.
				button_normal = {
					visible = "[And( Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ), GetVariableSystem.Exists( 'menatarms_open' ) )]"
					size = { 100% 100% }
					onclick = "[PdxGuiTriggerAllAnimations('menatarms_refresh')]"

					state = {
						name = _mouse_click
						delay = 0.2
						on_finish = "[Regiment.ToggleMaaView]"
					}
				}
			}

			# Pieces: the standard, then one piece per stack, each filled with
			# its soldiers (gold) and the missing soldiers (red), left aligned.
			# Count mode (max 12+) shows the count over the soldier bar.
			widget = {
				size = { 144 32 }
				tooltip = "MAAM_PIECES_TT"
				using = tooltip_se

				vbox = {
					ignoreinvisible = yes
					size = { 100% 100% }
					spacing = 4

					expand = {}
					hbox = {
						ignoreinvisible = yes
						layoutpolicy_horizontal = expanding
