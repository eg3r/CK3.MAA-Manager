		# Status pennants (the mockup's): 24 x 34 flags with their drop shadow
		# (26 x 36 texture) hanging from the top edge, over the border; the
		# tile tooltip names them. Red = Unraised / Unstationed, gold =
		# Retraining, grey = Loaned; the icon is light on all. Unstationed
		# always shows (as on the game's tile, next to Unraised): alone in the
		# right slot, else one slot to the left of the other pennant.
		widget = {
			parentanchor = top|right
			position = { -6 0 }
			size = { 54 36 }
			alwaystransparent = yes

			widget = {
				visible = "[GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"
