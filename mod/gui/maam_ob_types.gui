										layoutpolicy_vertical = expanding
										layoutstretchfactor_horizontal = "[Subtract_int32( Multiply_int32( Regiment.CalcMenAliveCount, Regiment.GetMAAChunkCount ), Multiply_int32( Regiment.GetMaxCount, '(int32)10' ) )]"
										alwaystransparent = yes
										background = {
											texture = "gfx/interface/colors/white.dds"
											tintcolor = { 0.62 0.53 0.36 1 }
										}
									}
									widget = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										layoutstretchfactor_horizontal = "[Subtract_int32( Multiply_int32( Regiment.GetMaxCount, '(int32)11' ), Multiply_int32( Regiment.CalcMenAliveCount, Regiment.GetMAAChunkCount ) )]"
										alwaystransparent = yes
										background = {
											texture = "gfx/interface/colors/white.dds"
											tintcolor = { 0.26 0.12 0.10 1 }
										}
									}
								}
								widget = {
									size = { 100% 100% }
									alwaystransparent = yes
									background = {
										texture = "gfx/interface/icons/maam/frame_1px.dds"
										spriteType = Corneredtiled
										spriteborder = { 2 2 }
										tintcolor = { 0.40 0.33 0.20 1 }
									}
								}
							}
							widget = {
								visible = "[Not( GreaterThan_int32( Regiment.GetMAAChunkCount, '(int32)10' ) )]"
								size = { 9 9 }
								alwaystransparent = yes
								background = {
									texture = "gfx/interface/colors/white.dds"
									tintcolor = { 0.10 0.11 0.12 1 }
								}
								background = {
									texture = "gfx/interface/icons/maam/frame_1px.dds"
									spriteType = Corneredtiled
									spriteborder = { 2 2 }
									tintcolor = { 0.40 0.42 0.45 1 }
								}
							}
						}
					}

						# Max size 12+: the count is the piece.
						maam_btn = {
							visible = "[And( GreaterThan_int32( Regiment.CalcMaxMAAChunkCount, '(int32)11' ), Or( And( GetScriptedGui('maam_ob_idle').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), And( GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), GreaterThan_int32( Regiment.GetMAAChunkCount, '(int32)1' ) ) ), And( GetScriptedGui('maam_ob_is_src').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), GetScriptedGui('maam_ob_kind_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'lift' ) ).End ) ) ) )]"
							size = { 56 18 }
							text = "MAAM_COUNT"
							tooltip = "[SelectLocalization( And( GetScriptedGui('maam_ob_is_src').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), GetScriptedGui('maam_ob_kind_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'lift' ) ).End ) ), 'MAAM_PIECE_PUTDOWN_TT', 'MAAM_PIECE_LIFT_TT' )]"
							onclick = "[GetVariableSystem.Clear( 'maam_ob_settings' )]"
							onclick = "[GetScriptedGui('maam_ob_lift').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"
						}
						text_single = {
							visible = "[And( GreaterThan_int32( Regiment.CalcMaxMAAChunkCount, '(int32)11' ), Not( Or( And( GetScriptedGui('maam_ob_idle').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), And( GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), GreaterThan_int32( Regiment.GetMAAChunkCount, '(int32)1' ) ) ), And( GetScriptedGui('maam_ob_is_src').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), GetScriptedGui('maam_ob_kind_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'lift' ) ).End ) ) ) ) )]"
							text = "MAAM_COUNT"
							default_format = "#high"
							using = Font_Size_Small
						}

						# Lone standard: the red control (only when a lane can take it).
						hbox = {
							ignoreinvisible = yes
							spacing = 0

							hbox = {
								ignoreinvisible = yes
								name = "maam_room"
								datamodel = "[MilitaryItem.GetOwnedMaa]"

								item = {
									widget = {
										size = { 0 0 }
										visible = "[And( And( ObjectsEqual( Regiment.GetMAAType, MenAtArmsType.Self ), Or( Regiment.IsPersonal, ObjectsEqual( Regiment.GetOwningTitle, Regiment.GetControllingTitle ) ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
