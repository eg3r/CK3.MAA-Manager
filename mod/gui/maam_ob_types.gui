									onclick = "[GetScriptedGui('maam_ob_merge_start').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"
								}
							}
						}

						expand = {}
					}

				hbox = {
					ignoreinvisible = yes
					visible = "[GreaterThan_int32( Regiment.CalcMaxMAAChunkCount, '(int32)11' )]"
					layoutpolicy_horizontal = expanding

					hbox = {
						ignoreinvisible = yes
						minimumsize = { 118 4 }
						maximumsize = { 118 4 }
						tooltip = "MAAM_SOLDIER_BAR_TT"

						background = {
							texture = "gfx/interface/colors/white.dds"
							tintcolor = { 0.20 0.21 0.23 1 }
						}
						widget = {
							visible = "[GreaterThan_int32( Regiment.CalcMenAliveCount, '(int32)0' )]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							layoutstretchfactor_horizontal = "[Regiment.CalcMenAliveCount]"
							background = {
								texture = "gfx/interface/colors/white.dds"
								tintcolor = { 0.79 0.66 0.42 1 }
							}
						}
						widget = {
							visible = "[GreaterThan_int32( Subtract_int32( Regiment.GetMaxCount, Regiment.CalcMenAliveCount ), '(int32)0' )]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							layoutstretchfactor_horizontal = "[Subtract_int32( Regiment.GetMaxCount, Regiment.CalcMenAliveCount )]"
							background = {
