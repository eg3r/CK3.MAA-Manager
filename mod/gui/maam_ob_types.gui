							widget = {
								visible = "[And( GetScriptedGui('maam_ob_idle').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), And( GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), And( EqualTo_int32( Regiment.GetMAAChunkCount, '(int32)1' ), Or( And( LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ), GreaterThan_int32( PdxGuiWidget.AccessParent.FindChild( 'maam_room' ).CountVisibleChildren, '(int32)1' ) ), And( Not( LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) ), GreaterThan_int32( PdxGuiWidget.AccessParent.FindChild( 'maam_room' ).CountVisibleChildren, '(int32)0' ) ) ) ) ) )]"
								size = { 18 16 }
								tooltip = "MAAM_LOWER_TT"

								background = {
									texture = "gfx/interface/colors/white.dds"
									tintcolor = { 0.45 0.14 0.11 1 }
