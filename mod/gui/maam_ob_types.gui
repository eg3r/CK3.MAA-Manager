						}
					}
				}

				hbox = {
					ignoreinvisible = yes
					spacing = 4
					minimumsize = { 64 0 }

					expand = {}

					# Move soldiers (only where soldiers can flow).
					button_round = {
						visible = "[And( And( GetScriptedGui('maam_ob_idle').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), Or( And( Not( Regiment.IsAtFullStength ), Or( And( GreaterThan_int32( Regiment.CalcMenAliveCount, Divide_int32( Regiment.GetMaxCount, Regiment.GetMAAChunkCount ) ), GreaterThan_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_can_give' ).CountVisibleChildren, '(int32)1' ) ), And( Not( GreaterThan_int32( Regiment.CalcMenAliveCount, Divide_int32( Regiment.GetMaxCount, Regiment.GetMAAChunkCount ) ) ), GreaterThan_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_can_give' ).CountVisibleChildren, '(int32)0' ) ) ) ), And( GreaterThan_int32( Regiment.CalcMenAliveCount, Divide_int32( Regiment.GetMaxCount, Regiment.GetMAAChunkCount ) ), Or( And( Not( Regiment.IsAtFullStength ), GreaterThan_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_not_full' ).CountVisibleChildren, '(int32)1' ) ), And( Not( Not( Regiment.IsAtFullStength ) ), GreaterThan_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_not_full' ).CountVisibleChildren, '(int32)0' ) ) ) ) ) )]"
						size = { 30 30 }
						tooltip = "MAAM_POUR_TT"
						enabled = "[GetScriptedGui('maam_ob_pour_start').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"
						onclick = "[GetVariableSystem.Clear( 'maam_ob_settings' )]"
						onclick = "[GetScriptedGui('maam_ob_pour_start').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"

						button_icon = {
							parentanchor = center
							size = { 22 22 }
							texture = "gfx/interface/icons/flat_icons/army_reorganize.dds"
							alwaystransparent = yes
						}
					}

					# Retrain: the armory (personal regiments, supported rulers), opened
					# as the recruitment window, or its horde mode for nomads ...
					button_round = {
						visible = "[And( And( GetScriptedGui('maam_ob_idle').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), And( And( Regiment.IsPersonal, GetScriptedGui('maam_rt_ruler_supported').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), Not( IsNomad( GetPlayer ) ) ) )]"
						size = { 30 30 }
						enabled = "[And( And( GetScriptedGui('maam_rt_start').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'real_source', Regiment.MakeScope ).End ), Not( Or( MilitaryItem.IsOpen, MilitaryItem.IsNomadViewOpen ) ) ), Not( GetVariableSystem.Exists( 'maam_rt_busy' ) ) )]"
						tooltip = "[SelectLocalization( Or( MilitaryItem.IsOpen, MilitaryItem.IsNomadViewOpen ), 'MAAM_RETRAIN_PICKER_OPEN_TT', SelectLocalization( GetScriptedGui('maam_rt_start').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'real_source', Regiment.MakeScope ).End ), 'MAAM_RETRAIN_TT', 'MAAM_RETRAIN_BLOCKED_TT' ) )]"
						onclick = "[GetVariableSystem.Set( 'maam_rt_busy', 'yes' )]"
						onclick = "[GetVariableSystem.Set( 'maam_rt_reopen_gui', 'yes' )]"
						onclick = "[GetVariableSystem.Clear( 'maam_rt_commit_gui' )]"
						onclick = "[GetVariableSystem.Clear( 'maam_rt_role' )]"
						onclick = "[GetVariableSystem.Clear( 'maam_rt_name' )]"
						onclick = "[GetVariableSystem.Set( 'maam_rt_old_name', Regiment.GetNameNoTooltip )]"
						onclick = "[GetVariableSystem.Clear( 'maam_ob_settings' )]"
						onclick = "[GetScriptedGui('maam_rt_start').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'real_source', Regiment.MakeScope ).End )]"
						onclick = "[MilitaryItem.OnClick]"

						button_replace = {
							parentanchor = center
							size = { 22 22 }
							alwaystransparent = yes
						}
					}

					button_round = {
						visible = "[And( And( GetScriptedGui('maam_ob_idle').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), And( And( Regiment.IsPersonal, GetScriptedGui('maam_rt_ruler_supported').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), IsNomad( GetPlayer ) ) )]"
						size = { 30 30 }
						enabled = "[And( And( GetScriptedGui('maam_rt_start').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'real_source', Regiment.MakeScope ).End ), Not( Or( MilitaryItem.IsOpen, MilitaryItem.IsNomadViewOpen ) ) ), Not( GetVariableSystem.Exists( 'maam_rt_busy' ) ) )]"
						tooltip = "[SelectLocalization( Or( MilitaryItem.IsOpen, MilitaryItem.IsNomadViewOpen ), 'MAAM_RETRAIN_PICKER_OPEN_TT', SelectLocalization( GetScriptedGui('maam_rt_start').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'real_source', Regiment.MakeScope ).End ), 'MAAM_RETRAIN_TT', 'MAAM_RETRAIN_BLOCKED_TT' ) )]"
						onclick = "[GetVariableSystem.Set( 'maam_rt_busy', 'yes' )]"
						onclick = "[GetVariableSystem.Set( 'maam_rt_reopen_gui', 'yes' )]"
						onclick = "[GetVariableSystem.Clear( 'maam_rt_commit_gui' )]"
						onclick = "[GetVariableSystem.Clear( 'maam_rt_role' )]"
						onclick = "[GetVariableSystem.Clear( 'maam_rt_name' )]"
						onclick = "[GetVariableSystem.Set( 'maam_rt_old_name', Regiment.GetNameNoTooltip )]"
						onclick = "[GetVariableSystem.Clear( 'maam_ob_settings' )]"
						onclick = "[GetScriptedGui('maam_rt_start').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'real_source', Regiment.MakeScope ).End )]"
						onclick = "[MilitaryItem.OnClickNomad]"

						button_replace = {
							parentanchor = center
							size = { 22 22 }
							alwaystransparent = yes
						}
					}

					# ... inactive with the reason (title regiments, or the ruler can't retrain now).
					button_round = {
						visible = "[And( And( GetScriptedGui('maam_ob_idle').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), Not( And( Regiment.IsPersonal, GetScriptedGui('maam_rt_ruler_supported').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) )]"
						size = { 30 30 }
						enabled = no
						tooltip = "[SelectLocalization( Regiment.IsPersonal, 'MAAM_RETRAIN_UNSUPPORTED_TT', 'MAAM_RETRAIN_TITLE_TT' )]"

						button_replace = {
							parentanchor = center
							size = { 22 22 }
							alwaystransparent = yes
						}
					}

					# At war or armies raised: visible, inactive, with the reason.
					button_round = {
						visible = "[And( And( GetScriptedGui('maam_ob_blocked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), And( Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ), GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ) ), Or( And( Not( Regiment.IsAtFullStength ), Or( And( GreaterThan_int32( Regiment.CalcMenAliveCount, Divide_int32( Regiment.GetMaxCount, Regiment.GetMAAChunkCount ) ), GreaterThan_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_can_give' ).CountVisibleChildren, '(int32)1' ) ), And( Not( GreaterThan_int32( Regiment.CalcMenAliveCount, Divide_int32( Regiment.GetMaxCount, Regiment.GetMAAChunkCount ) ) ), GreaterThan_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_can_give' ).CountVisibleChildren, '(int32)0' ) ) ) ), And( GreaterThan_int32( Regiment.CalcMenAliveCount, Divide_int32( Regiment.GetMaxCount, Regiment.GetMAAChunkCount ) ), Or( And( Not( Regiment.IsAtFullStength ), GreaterThan_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_not_full' ).CountVisibleChildren, '(int32)1' ) ), And( Not( Not( Regiment.IsAtFullStength ) ), GreaterThan_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild( 'maam_not_full' ).CountVisibleChildren, '(int32)0' ) ) ) ) ) )]"
						size = { 30 30 }
						enabled = no
						tooltip = "MAAM_BLOCKED_TT"

						button_icon = {
							parentanchor = center
							size = { 22 22 }
							texture = "gfx/interface/icons/flat_icons/army_reorganize.dds"
							alwaystransparent = yes
						}
					}
					button_round = {
						visible = "[And( GetScriptedGui('maam_ob_blocked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), And( Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ), GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ) )]"
						size = { 30 30 }
						enabled = no
						tooltip = "MAAM_BLOCKED_TT"

						button_replace = {
							parentanchor = center
							size = { 22 22 }
							alwaystransparent = yes
						}
					}

					# Receiving a lifted stack.
					maam_chip = {
						visible = "[And( And( GetScriptedGui('maam_ob_lane_receive').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
						blockoverride "maam_chip_text" {
							text = "MAAM_PLACE"
						}
						blockoverride "maam_chip_button" {
							tooltip = "MAAM_PLACE_TT"
							onclick = "[GetScriptedGui('maam_ob_place').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target_regiment', Regiment.MakeScope ).AddScope( 'type_relation', MakeScopeFlag( 'same' ) ).AddScope( 'gui_room', MakeScopeFlag( Select_CString( LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ), 'yes', 'no' ) ) ).End )]"
						}
					}

				}
			}
		}
	}

	######################################################
	# Tile (tiles view; Regiment datacontext): the game's own 166 x 90 tile.
	# The picture, the status pennant hanging from the top right, the thin
	# stack pieces filled with soldiers, and the native bottom bar (type icon +
	# soldiers, upkeep). Selected = gold border. The actions live in the strip;
	# during an order the whole tile is the target (Place / Merge here). Every
	# child has a fixed size and position, so nothing can grow out of the tile.
	######################################################
	type maam_ob_tile = widget
	{
		datacontext = "[Regiment.GetMAAType]"
		size = { 166 90 }
		alpha = "[Select_float( Or( And( GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Not( Or( GetScriptedGui('maam_ob_is_src').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), Or( And( And( GetScriptedGui('maam_ob_lane_receive').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) ), Or( And( And( GetScriptedGui('maam_ob_lane_merge').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) ), GetScriptedGui('maam_ob_lane_pour_picked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ) ) ) ) ), And( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, Not( GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ) ) ), '(float)0.5', '(float)1.0' )]"
		using = tooltip_es

		background = {
			visible = "[Not( Or( GetScriptedGui('maam_ob_sel_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), Regiment.IsShownInMaaView ) )]"
			texture = "[MenAtArmsType.GetHorizontalImageForCulture( GetPlayer.GetCulture )]"
			alpha = 0.8
			fittype = centercrop
		}
		background = {
			visible = "[Or( GetScriptedGui('maam_ob_sel_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), Regiment.IsShownInMaaView )]"
			texture = "[MenAtArmsType.GetHorizontalImageForCulture( GetPlayer.GetCulture )]"
			fittype = centercrop
		}
		background = {
			visible = "[And( And( GetScriptedGui('maam_ob_lane_receive').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.30 0.55 0.32 0.25 }
		}
		background = {
			visible = "[And( And( GetScriptedGui('maam_ob_lane_merge').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.62 0.20 0.16 0.28 }
		}
		background = {
			texture = "gfx/interface/component_tiles/tile_vignette_3px.dds"
			spriteType = Corneredtiled
			spriteborder = { 5 5 }
		}

		state = {
			name = maam_close_on_retrain
			trigger_when = "[And( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, Regiment.IsShownInMaaView )]"
			on_start = "[Regiment.ToggleMaaView]"
		}

		tooltipwidget = {
			using = maam_regiment_tooltip

			blockoverride "maam_status" {
				# Same style as the game's station line above it.
				hbox = {
					ignoreinvisible = yes
					visible = "[GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"
					layoutpolicy_horizontal = expanding
					margin = { 15 0 }

					text_multi = {
						text = "MAAM_TT_RETRAINING"
						default_format = "#weak"
						autoresize = yes
					}
					expand = {}
				}
				hbox = {
					ignoreinvisible = yes
					visible = "[And( Not( GetScriptedGui('maam_rt_tile_is_source').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), And( Not( Regiment.IsPersonal ), Not( ObjectsEqual( Regiment.GetOwningTitle, Regiment.GetControllingTitle ) ) ) )]"
					layoutpolicy_horizontal = expanding
					margin = { 15 0 }

					text_multi = {
						text = "MAAM_TT_LOANED"
						default_format = "#weak"
						autoresize = yes
					}
					expand = {}
				}
			}

			# As the game's tile: a divider and its "Click to select".
			blockoverride "extra_info" {
				divider_light = {
					layoutpolicy_horizontal = expanding
				}
				text_single = {
					layoutpolicy_horizontal = expanding
					text = "[SelectLocalization( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, 'MAAM_LANE_LOCKED_HINT', 'CLICK_TO_SELECT' )]"
					margin = { 10 0 }
				}
			}
		}

		# Click: select (the strip offers its actions) and open its window;
		# clicking the selected tile again deselects and closes it.
		button_normal = {
			visible = "[And( And( GetScriptedGui('maam_ob_idle').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), And( Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ), Not( GetVariableSystem.Exists( 'menatarms_open' ) ) ) )]"
			size = { 100% 100% }
			onclick = "[GetVariableSystem.Clear( 'maam_ob_settings' )]"
			onclick = "[GetScriptedGui('maam_ob_select').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"
			onclick = "[Regiment.ToggleMaaView]"
		}
		button_normal = {
			visible = "[And( And( GetScriptedGui('maam_ob_idle').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), GetScriptedGui('maam_ob_lane_ok').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ), And( Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ), GetVariableSystem.Exists( 'menatarms_open' ) ) )]"
			size = { 100% 100% }
			onclick = "[GetVariableSystem.Clear( 'maam_ob_settings' )]"
			onclick = "[GetScriptedGui('maam_ob_select').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"
			onclick = "[PdxGuiTriggerAllAnimations('menatarms_refresh')]"

			state = {
				name = _mouse_click
				delay = 0.2
				on_finish = "[Regiment.ToggleMaaView]"
			}
		}
		# Blocked realm: the tile still opens its window (read only).
		button_normal = {
			visible = "[And( And( GetScriptedGui('maam_ob_blocked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), Not( GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), And( Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ), Not( GetVariableSystem.Exists( 'menatarms_open' ) ) ) )]"
			size = { 100% 100% }
			onclick = "[Regiment.ToggleMaaView]"
		}

		# During an order the whole tile is the target.
		button_normal = {
			visible = "[And( And( GetScriptedGui('maam_ob_lane_receive').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
			size = { 100% 100% }
			tooltip = "MAAM_PLACE_TT"
			onclick = "[GetScriptedGui('maam_ob_place').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target_regiment', Regiment.MakeScope ).AddScope( 'type_relation', MakeScopeFlag( 'same' ) ).AddScope( 'gui_room', MakeScopeFlag( Select_CString( LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ), 'yes', 'no' ) ) ).End )]"
			clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
		}
		button_normal = {
			visible = "[And( And( GetScriptedGui('maam_ob_lane_merge').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ) )]"
			size = { 100% 100% }
			tooltip = "MAAM_MERGE_HERE_TT"
			onclick = "[GetScriptedGui('maam_ob_merge').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target_regiment', Regiment.MakeScope ).AddScope( 'type_relation', MakeScopeFlag( 'same' ) ).AddScope( 'gui_room', MakeScopeFlag( Select_CString( LessThan_int32( Regiment.GetMAAChunkCount, Regiment.CalcMaxMAAChunkCount ), 'yes', 'no' ) ) ).End )]"
			clicksound = "event:/SFX/UI/Unit/Army/sfx_ui_unit_army_merge"
		}

		# The game's bottom bar: type icon and soldiers left, upkeep right.
		hbox = {
			ignoreinvisible = yes
			parentanchor = bottom|left
			minimumsize = { 166 22 }
			maximumsize = { 166 22 }
			margin = { 5 0 }
			spacing = 3
			alwaystransparent = yes

