				spriteborder = { 2 2 }
				tintcolor = { 0.85 0.36 0.29 1 }
			}
			hbox = {
				ignoreinvisible = yes
				size = { 100% 100% }
				spacing = 4
				alwaystransparent = yes

				expand = {}
				icon_flat_standard_gold = {
					size = { 14 14 }
					texture = "gfx/interface/icons/flat_icons/army_merge.dds"
					alwaystransparent = yes
				}
				text_single = {
					text = "MAAM_MERGE_HERE"
					default_format = "#high"
					using = Font_Size_Small
					align = left|nobaseline
					fontsize_min = 13
					alwaystransparent = yes
				}
				expand = {}
			}
		}
		widget = {
			visible = "[GetScriptedGui('maam_ob_lane_pour_picked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End )]"
			parentanchor = top|hcenter
			position = { -6 14 }
			size = { 66 20 }
			alwaystransparent = yes

			background = {
				texture = "gfx/interface/colors/white.dds"
				tintcolor = { 0.16 0.14 0.09 0.92 }
			}
			background = {
				texture = "gfx/interface/icons/maam/frame_1px.dds"
				spriteType = Corneredtiled
				spriteborder = { 2 2 }
				tintcolor = { 0.72 0.60 0.36 1 }
			}
			hbox = {
				ignoreinvisible = yes
				size = { 100% 100% }
				spacing = 4
				alwaystransparent = yes

				expand = {}
				text_single = {
					text = "MAAM_PAIRED"
					default_format = "#high"
					using = Font_Size_Small
					align = left|nobaseline
					fontsize_min = 13
					alwaystransparent = yes
				}
				expand = {}
			}
		}

		# A soldier move is open on another regiment of this type: join its
		# partner list (GUI type comparison, so any modded type works).
		widget = {
			visible = "[And( And( And( GetScriptedGui('maam_ob_kind_gui').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'pour' ) ).End ), ObjectsEqual( Regiment.GetMAAType, GetPlayer.MakeScope.Var('maam_ob_src').Regiment.GetMAAType ) ), Not( GetScriptedGui('maam_ob_is_src').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'regiment', Regiment.MakeScope ).End ) ) ), Or( Regiment.IsPersonal, ObjectsEqual( Regiment.GetOwningTitle, Regiment.GetControllingTitle ) ) )]"
			size = { 1 1 }

			state = {
				name = _show
				on_start = "[GetScriptedGui('maam_ob_pour_register').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target_regiment', Regiment.MakeScope ).AddScope( 'type_relation', MakeScopeFlag( 'same' ) ).End )]"
			}
		}

	}

	######################################################
	# Grouped view: one section per type, in order of first appearance.
	# Item of a list over MilitaryItem.GetOwnedMaa; only the first regiment of
	# each type draws the group (no earlier same-type item in maam_earlier).
	######################################################
	type maam_ob_group_item = vbox
	{
		layoutpolicy_horizontal = expanding
		ignoreinvisible = yes
		datacontext = "[Regiment.GetMAAType]"

		hbox = {
			ignoreinvisible = yes
			name = "maam_earlier"
			datamodel = "[MilitaryItem.GetOwnedMaa]"

			item = {
				widget = {
					size = { 0 0 }
					visible = "[And( EqualTo_string( Regiment.GetMAAType.GetBaseTypeName, MenAtArmsType.GetBaseTypeName ), LessThan_int32( PdxGuiWidget.GetIndexInDataModel, PdxGuiWidget.AccessParent.AccessParent.GetIndexInDataModel ) )]"
				}
			}
		}

		vbox = {
			ignoreinvisible = yes
			visible = "[EqualTo_int32( PdxGuiWidget.AccessParent.FindChild( 'maam_earlier' ).CountVisibleChildren, '(int32)0' )]"
			layoutpolicy_horizontal = expanding
			spacing = 4
			margin_bottom = 6

			# Header: folds the group (never while an order or retrain is open).
			widget = {
				layoutpolicy_horizontal = expanding
				size = { 0 28 }

				background = {
					texture = "gfx/interface/colors/white.dds"
					tintcolor = { 0.17 0.16 0.13 0.95 }
				}
				background = {
					texture = "gfx/interface/icons/maam/frame_1px.dds"
					spriteType = Corneredtiled
					spriteborder = { 2 2 }
					tintcolor = { 0.40 0.33 0.20 1 }
				}

				hbox = {
					ignoreinvisible = yes
					size = { 100% 100% }
					margin = { 6 0 }
					spacing = 6

					hbox = {
						ignoreinvisible = yes
						name = "maam_all"
						datamodel = "[MilitaryItem.GetOwnedMaa]"

						item = {
							widget = {
								size = { 0 0 }
								visible = "[EqualTo_string( Regiment.GetMAAType.GetBaseTypeName, MenAtArmsType.GetBaseTypeName )]"
							}
						}
					}

					# Native tree arrow: down while open, right while folded.
					button_expand = {
						size = { 20 20 }
						alwaystransparent = yes
						frame = "[BoolTo1And2( Not( GetVariableSystem.Exists( Concatenate( 'maam_fold_', MenAtArmsType.GetBaseTypeName ) ) ) )]"
					}
					icon = {
						size = { 22 22 }
						texture = "[MenAtArmsType.GetIcon]"
					}
					text_single = {
						text = "[MenAtArmsType.GetBaseTypeName]"
						default_format = "#high"
						max_width = 220
						elide = right
					}
					text_single = {
						text = "[PdxGuiWidget.AccessParent.FindChild( 'maam_all' ).CountVisibleChildren]"
						default_format = "#weak"
						using = Font_Size_Small
					}
					text_single = {
						visible = "[EqualTo_int32( PdxGuiWidget.AccessParent.FindChild( 'maam_all' ).CountVisibleChildren, '(int32)1' )]"
						text = "MAAM_GROUP_REGIMENT"
						default_format = "#weak"
						using = Font_Size_Small
					}
					text_single = {
						visible = "[Not( EqualTo_int32( PdxGuiWidget.AccessParent.FindChild( 'maam_all' ).CountVisibleChildren, '(int32)1' ) )]"
						text = "MAAM_GROUP_REGIMENTS"
						default_format = "#weak"
						using = Font_Size_Small
					}
					expand = {}
				}

				button_normal = {
					size = { 100% 100% }
					enabled = "[Not( Or( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
					tooltip = "[SelectLocalization( Or( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), 'MAAM_GROUP_FROZEN_TT', 'MAAM_GROUP_FOLD_TT' )]"
					onclick = "[GetVariableSystem.Toggle( Concatenate( 'maam_fold_', MenAtArmsType.GetBaseTypeName ) )]"
				}
			}

			vbox = {
				visible = "[Not( GetVariableSystem.Exists( Concatenate( 'maam_fold_', MenAtArmsType.GetBaseTypeName ) ) )]"
				layoutpolicy_horizontal = expanding
				datamodel = "[MilitaryItem.GetOwnedMaa]"
				ignoreinvisible = yes
				spacing = 4

				item = {
					vbox = {
						ignoreinvisible = yes
						visible = "[EqualTo_string( Regiment.GetMAAType.GetBaseTypeName, MenAtArmsType.GetBaseTypeName )]"
						layoutpolicy_horizontal = expanding

						maam_ob_lane = {}
					}
				}
			}
		}
	}

	######################################################
	# View buttons (right of Raise All): list, grouped, tiles (each click is also
	# saved as the view for the next opening), settings (parked).
	# Framed squares like the native header buttons; the active one is down.
	######################################################
	type maam_ob_view_buttons = hbox
	{
		spacing = 3
		maximumsize = { 129 30 }

		button_standard = {
			size = { 30 30 }
			down = "[Not( Or( GetVariableSystem.HasValue( 'maam_board_view', 'grouped' ), GetVariableSystem.HasValue( 'maam_board_view', 'tiles' ) ) )]"
			enabled = "[Not( Or( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
			tooltip = "[SelectLocalization( Or( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), 'MAAM_VIEW_LOCKED_TT', 'MAAM_VIEW_LIST_TT' )]"
			using = tooltip_sw
			onclick = "[GetVariableSystem.Set( 'maam_board_view', 'list' )]"
			onclick = "[GetScriptedGui('maam_ob_pref').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'list' ) ).End )]"

			button_icon = {
				parentanchor = center
				size = { 20 20 }
				texture = "gfx/interface/icons/maam/view_list.dds"
				alwaystransparent = yes
			}
		}
		button_standard = {
			size = { 30 30 }
			down = "[GetVariableSystem.HasValue( 'maam_board_view', 'grouped' )]"
			enabled = "[Not( Or( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
			tooltip = "[SelectLocalization( Or( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), 'MAAM_VIEW_LOCKED_TT', 'MAAM_VIEW_GROUPED_TT' )]"
			using = tooltip_sw
			onclick = "[GetVariableSystem.Set( 'maam_board_view', 'grouped' )]"
			onclick = "[GetScriptedGui('maam_ob_pref').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'grouped' ) ).End )]"

			button_icon = {
				parentanchor = center
				size = { 20 20 }
				texture = "gfx/interface/icons/maam/view_grouped.dds"
				alwaystransparent = yes
			}
		}
		button_standard = {
			size = { 30 30 }
			down = "[GetVariableSystem.HasValue( 'maam_board_view', 'tiles' )]"
			enabled = "[Not( Or( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
			tooltip = "[SelectLocalization( Or( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), 'MAAM_VIEW_LOCKED_TT', 'MAAM_VIEW_TILES_TT' )]"
			using = tooltip_sw
			onclick = "[GetVariableSystem.Set( 'maam_board_view', 'tiles' )]"
			onclick = "[GetScriptedGui('maam_ob_pref').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'tiles' ) ).End )]"

			button_icon = {
				parentanchor = center
				size = { 20 20 }
				texture = "gfx/interface/icons/maam/view_tiles.dds"
				alwaystransparent = yes
			}
		}
		button_standard = {
			size = { 30 30 }
			# Parked: the view is saved on click, so there is nothing to set yet
			# (the strip's settings state stays for later use).
			enabled = no
			tooltip = "MAAM_SETTINGS_TT"
			using = tooltip_sw

			button_icon = {
				parentanchor = center
				size = { 20 20 }
				texture = "gfx/interface/icons/flat_icons/menu.dds"
				alwaystransparent = yes
			}
		}
	}

	######################################################
	# Personal board: the strip, then the lanes in their own scroll area.
	# Needs the personal MilitaryItem context.
	######################################################
	type maam_ob_board_personal = vbox
	{
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		maximumsize = { 507 -1 }
		ignoreinvisible = yes
		spacing = 6

		maam_ob_strip_personal = {}

		# Retrain plumbing: reopen after a price check, cancel when the armory closes.
		widget = {
			size = { 0 0 }

			state = {
				name = maam_rt_reopen
				trigger_when = "[And( And( And( Or( GetVariableSystem.Exists( 'maam_rt_reopen_gui' ), GetVariableSystem.Exists( 'maam_rt_src_check_gui' ) ), GetPlayer.MakeScope.Var('maam_rt_reopen').IsSet ), Not( Or( MilitaryItem.IsOpen, MilitaryItem.IsNomadViewOpen ) ) ), Not( IsNomad( GetPlayer ) ) )]"
				on_start = "[GetScriptedGui('maam_rt_reopened').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				on_start = "[GetVariableSystem.Clear( 'maam_rt_src_check_gui' )]"
				on_start = "[MilitaryItem.OnClick]"
			}
			state = {
				name = maam_rt_reopen_nomad
				trigger_when = "[And( And( And( Or( GetVariableSystem.Exists( 'maam_rt_reopen_gui' ), GetVariableSystem.Exists( 'maam_rt_src_check_gui' ) ), GetPlayer.MakeScope.Var('maam_rt_reopen').IsSet ), Not( Or( MilitaryItem.IsOpen, MilitaryItem.IsNomadViewOpen ) ) ), IsNomad( GetPlayer ) )]"
				on_start = "[GetScriptedGui('maam_rt_reopened').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				on_start = "[GetVariableSystem.Clear( 'maam_rt_src_check_gui' )]"
				on_start = "[MilitaryItem.OnClickNomad]"
			}
			state = {
				name = maam_rt_closed
				trigger_when = "[And( And( GetPlayer.MakeScope.Var('maam_rt_active').IsSet, Not( Or( MilitaryItem.IsOpen, MilitaryItem.IsNomadViewOpen ) ) ), And( Not( GetVariableSystem.Exists( 'maam_rt_reopen_gui' ) ), And( Not( GetVariableSystem.Exists( 'maam_rt_commit_gui' ) ), Not( GetVariableSystem.Exists( 'maam_rt_src_check_gui' ) ) ) ) )]"
				on_start = "[GetScriptedGui('maam_rt_cancel').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'why', MakeScopeFlag( 'closed' ) ).End )]"
				on_start = "[GetVariableSystem.Clear( 'maam_rt_busy' )]"
			}
			state = {
				name = maam_rt_unbusy_idle
				trigger_when = "[Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet )]"
				on_start = "[GetVariableSystem.Clear( 'maam_rt_busy' )]"
				on_start = "[GetVariableSystem.Clear( 'maam_rt_reopen_gui' )]"
				on_start = "[GetVariableSystem.Clear( 'maam_rt_src_check_gui' )]"
				on_start = "[GetVariableSystem.Clear( 'maam_rt_commit_gui' )]"
			}
		}

		# Lanes: the scroll area takes all the free height of the middle area,
		# so the Create buttons sit at its bottom. No native scrollbox margins or
		# background; margin_right leaves room for the scrollbar.
		scrollbox = {
			name = "maam_lanes_scroll"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			size = { 0 90 }
			maximumsize = { 507 -1 }

			blockoverride "scrollbox_margins" {}
			blockoverride "scrollbox_background" {}
			blockoverride "scrollbox_background_fade" {}

			blockoverride "scrollbox_content"
			{
				vbox = {
					ignoreinvisible = yes
					layoutpolicy_horizontal = expanding

					# List: the game's own order.
					vbox = {
						ignoreinvisible = yes
						visible = "[Not( Or( GetVariableSystem.HasValue( 'maam_board_view', 'grouped' ), GetVariableSystem.HasValue( 'maam_board_view', 'tiles' ) ) )]"
						layoutpolicy_horizontal = expanding
						datamodel = "[MilitaryItem.GetOwnedMaa]"
						spacing = 4

						item = {
							maam_ob_lane = {}
						}
					}

					# Grouped by type.
					vbox = {
						visible = "[GetVariableSystem.HasValue( 'maam_board_view', 'grouped' )]"
						layoutpolicy_horizontal = expanding
						datamodel = "[MilitaryItem.GetOwnedMaa]"
						ignoreinvisible = yes

						item = {
							maam_ob_group_item = {}
						}
					}

					# Tiles, like the base game.
					hbox = {
						ignoreinvisible = yes
						visible = "[GetVariableSystem.HasValue( 'maam_board_view', 'tiles' )]"
						layoutpolicy_horizontal = expanding

						fixedgridbox = {
							datamodel = "[MilitaryItem.GetOwnedMaa]"
							flipdirection = yes
							datamodel_wrap = 3
							addcolumn = 169
							addrow = 93

							item = {
								maam_ob_tile = {}
							}
						}
						expand = {}
					}
				}
			}
		}
	}

	######################################################
	# Command strip (personal board): two fixed rows.
	# Row 1 says what is going on; row 2 left holds neutral or arming controls,
	# row 2 right the exit (for a selected tile: the red Merge last stack).
	# A red control never takes a harmless one's slot.
	######################################################
	type maam_ob_strip_personal = widget
	{
		layoutpolicy_horizontal = expanding
		size = { 0 66 }
		maximumsize = { 507 66 }

		background = {
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.13 0.135 0.15 0.95 }
		}
		background = {
			texture = "gfx/interface/icons/maam/frame_1px.dds"
			spriteType = Corneredtiled
			spriteborder = { 2 2 }
			tintcolor = { 0.27 0.28 0.30 1 }
		}
		background = {
			visible = "[Or( And( And( And( And( And( Not( GetVariableSystem.Exists( 'maam_ob_settings' ) ), Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ) ), Not( GetScriptedGui('maam_ob_blocked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), And( Not( And( GetVariableSystem.HasValue( 'maam_board_view', 'tiles' ), GetScriptedGui('maam_ob_has_sel').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_rt_has_result').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) ), GetScriptedGui('maam_qm_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'grow' ) ).End ) ), Or( And( And( And( And( And( Not( GetVariableSystem.Exists( 'maam_ob_settings' ) ), Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ) ), Not( GetScriptedGui('maam_ob_blocked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), And( Not( And( GetVariableSystem.HasValue( 'maam_board_view', 'tiles' ), GetScriptedGui('maam_ob_has_sel').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_rt_has_result').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) ), GetScriptedGui('maam_qm_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'combine' ) ).End ) ), And( And( And( And( And( Not( GetVariableSystem.Exists( 'maam_ob_settings' ) ), Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ) ), Not( GetScriptedGui('maam_ob_blocked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), And( Not( And( GetVariableSystem.HasValue( 'maam_board_view', 'tiles' ), GetScriptedGui('maam_ob_has_sel').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_rt_has_result').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) ), Not( Or( GetScriptedGui('maam_qm_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'grow' ) ).End ), GetScriptedGui('maam_qm_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'combine' ) ).End ) ) ) ) ) )]"
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.16 0.145 0.11 0.95 }
		}
		background = {
			visible = "[Or( And( And( And( And( And( Not( GetVariableSystem.Exists( 'maam_ob_settings' ) ), Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ) ), Not( GetScriptedGui('maam_ob_blocked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), And( Not( And( GetVariableSystem.HasValue( 'maam_board_view', 'tiles' ), GetScriptedGui('maam_ob_has_sel').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_rt_has_result').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) ), GetScriptedGui('maam_qm_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'grow' ) ).End ) ), Or( And( And( And( And( And( Not( GetVariableSystem.Exists( 'maam_ob_settings' ) ), Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ) ), Not( GetScriptedGui('maam_ob_blocked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), And( Not( And( GetVariableSystem.HasValue( 'maam_board_view', 'tiles' ), GetScriptedGui('maam_ob_has_sel').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_rt_has_result').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) ), GetScriptedGui('maam_qm_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'combine' ) ).End ) ), And( And( And( And( And( Not( GetVariableSystem.Exists( 'maam_ob_settings' ) ), Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ) ), Not( GetScriptedGui('maam_ob_blocked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), And( Not( And( GetVariableSystem.HasValue( 'maam_board_view', 'tiles' ), GetScriptedGui('maam_ob_has_sel').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_rt_has_result').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ) ), Not( Or( GetScriptedGui('maam_qm_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'grow' ) ).End ), GetScriptedGui('maam_qm_is').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'want', MakeScopeFlag( 'combine' ) ).End ) ) ) ) ) )]"
			texture = "gfx/interface/icons/maam/frame_1px.dds"
			spriteType = Corneredtiled
			spriteborder = { 2 2 }
			tintcolor = { 0.42 0.34 0.20 1 }
		}
		background = {
			visible = "[And( And( And( And( Not( GetVariableSystem.Exists( 'maam_ob_settings' ) ), Not( GetPlayer.MakeScope.Var('maam_rt_active').IsSet ) ), Not( GetScriptedGui('maam_ob_blocked').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), Not( GetScriptedGui('maam_ob_has_order').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), And( GetVariableSystem.HasValue( 'maam_board_view', 'tiles' ), GetScriptedGui('maam_ob_has_sel').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
			texture = "gfx/interface/colors/white.dds"
			tintcolor = { 0.13 0.135 0.15 0.95 }
