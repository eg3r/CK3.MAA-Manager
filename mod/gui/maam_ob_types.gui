								visible = "[And( GreaterThan_int32( Regiment.GetMAAChunkCount, '(int32)10' ), Not( Or( GreaterThanOrEqualTo_int32( Multiply_int32( Regiment.CalcMenAliveCount, Regiment.GetMAAChunkCount ), Multiply_int32( Regiment.GetMaxCount, '(int32)11' ) ), LessThanOrEqualTo_int32( Multiply_int32( Regiment.CalcMenAliveCount, Regiment.GetMAAChunkCount ), Multiply_int32( Regiment.GetMaxCount, '(int32)10' ) ) ) ) )]"
								size = { 9 9 }
								alwaystransparent = yes

